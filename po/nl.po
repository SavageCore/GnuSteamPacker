#: gnusteampacker/i18n.py:73 gnusteampacker/ui/preferences_window.py:183
msgid "Follow System"
msgstr "Volg systeem"

#: gnusteampacker/main.py:70
msgid ""
"A Linux-native GUI for downloading, cleaning, and packaging Steam games for "
"archival and sharing. Spiritual port of <a href=\"https://github.com/"
"Masquerade64/SuperSteamPacker\">SuperSteamPacker</a>."
msgstr ""
"Een Linux-native GUI voor het downloaden, schoonmaken en verpakking van "
"Steam games voor archiveren en delen. Spirituele poort van <a href=\"https://"
"github.com/Masquerade64/SuperSteamPacker\">SuperSteamPacker</a>."

